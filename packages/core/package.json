{
  "name": "@atena/core",
  "version": "0.0.0",
  "private": true,
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts",
    "dev": "tsup src/index.ts --format esm,cjs --dts --watch",
    "test": "vitest run"
  },
  "dependencies": {
    "@atena/api-types": "workspace:*",
    "@atena/utils": "workspace:*",
    "@atena/validators": "workspace:*",
    "@supabase/supabase-js": "^2.49.1",
    "date-fns": "^4.1.0",
    "resend": "^4.1.2",
    "stripe": "^17.7.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsup": "^8.5.1",
    "typescript": "^5.8.3"
  }
}

