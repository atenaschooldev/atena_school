model notification_logs {
  createdAt              DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  channel                Int                     @db.SmallInt
  notificationType       Int                     @map("notification_type") @db.SmallInt
  recipient              String                  @db.VarChar(255)
  subject                String?                 @db.VarChar(255)
  request                Json                    @default("{}")
  response               Json?
  status                 Int                     @db.SmallInt
  notificationTemplateId BigInt?                 @map("notification_template_id")
  notificationTriggerId  BigInt?                 @map("notification_trigger_id")
  id                     BigInt                  @id @default(autoincrement())
  template               notification_templates? @relation(fields: [notificationTemplateId], references: [id], onUpdate: NoAction)
  trigger                notification_triggers?  @relation(fields: [notificationTriggerId], references: [id], onUpdate: NoAction)

  @@index([recipient], map: "idx_notification_logs_recipient")
  @@index([createdAt(sort: Desc)], map: "idx_notification_logs_created_at")
  @@map("notification_logs")
}

model notification_templates {
