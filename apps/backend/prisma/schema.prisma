generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                 String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  email              String             @unique
  fullName           String             @map("full_name")
  role               Int                @default(1) @db.SmallInt
  isActive           Boolean            @default(true) @map("is_active")
  phone              String?
  taxCode            String?            @map("tax_code")
  sdiCode            String?            @map("sdi_code")
  pecEmail           String?            @map("pec_email")
  avatarUrl          String?            @map("avatar_url")
  notes              String?
  annual_memberships AnnualMembership[]
  bookings           Booking[]
  payments           Payment[]
  students           students[]
  teachers           Teacher[]

  @@index([role], map: "idx_users_role")
  @@index([taxCode], map: "idx_users_tax_code")
  @@index([phone], map: "idx_users_phone")
  @@index([createdAt(sort: Desc)], map: "idx_users_created_at")
  @@map("users")
}

model Course {
  createdAt            DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  name                 String
  slug                 String          @unique
  category             Int             @default(1) @db.SmallInt
  status               Int             @default(1) @db.SmallInt
  sortOrder            Int?            @default(0) @map("sort_order")
  photoUrl             String?         @map("photo_url")
  description          String?
  billingType          Int             @default(1) @map("billing_type") @db.SmallInt
  price                Decimal?        @db.Decimal(10, 2)
  subscriptionPrice    Decimal?        @map("subscription_price") @db.Decimal(10, 2)
  stripeMonthlyPriceId String?         @map("stripe_monthly_price_id")
  categoryId           BigInt?         @map("category_id")
  settingsId           BigInt?         @map("settings_id")
  teacherId            BigInt?         @map("teacher_id")
  id                   BigInt          @id @default(autoincrement())
  bookings             Booking[]
  courseTeachers       CourseTeacher[]
  courseCategory       CourseCategory? @relation(fields: [categoryId], references: [id], onUpdate: NoAction)
  settings             CourseSettings? @relation(fields: [settingsId], references: [id], onUpdate: NoAction)
  teachers             Teacher?        @relation(fields: [teacherId], references: [id], onUpdate: NoAction)
  formTemplates        FormTemplate[]
  groups               Group[]
  lessons              Lesson[]

  @@index([slug], map: "idx_courses_slug")
  @@index([status], map: "idx_courses_status")
  @@index([category], map: "idx_courses_category")
  @@map("courses")
}

model Teacher {
  user_id        String?         @db.Uuid
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  fullName       String?         @map("full_name")
  isActive       Boolean         @default(true) @map("is_active")
  experience     String?
  photoUrl       String?         @map("photo_url")
  colorValue     BigInt?         @default(4279899379) @map("color_value")
  hireDate       DateTime?       @default(dbgenerated("CURRENT_DATE")) @map("hire_date") @db.Date
  birthDate      DateTime?       @map("birth_date") @db.Date
  contractId     String?         @map("contract_id") @db.Uuid
  id             BigInt          @id @default(autoincrement())
  courseTeachers CourseTeacher[]
  courses        Course[]
  groups         Group[]
  lessons        Lesson[]
  users          User?           @relation(fields: [user_id], references: [id], onUpdate: NoAction)

  @@index([isActive], map: "idx_teachers_is_active")
  @@index([hireDate], map: "idx_teachers_hire_date")
  @@index([createdAt(sort: Desc)], map: "idx_teachers_created_at")
  @@map("teachers")
}

model CourseTeacher {
  role      Int      @default(1) @db.SmallInt
  isPrimary Boolean  @default(true) @map("is_primary")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  teacherId BigInt   @map("teacher_id")
  courseId  BigInt   @map("course_id")
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  teacher   Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([courseId, teacherId])
  @@map("course_teachers")
}

model Booking {
  id                   String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt            DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  sessionId            String?            @map("session_id")
  userId               String?            @map("user_id") @db.Uuid
  studentId            String?            @map("student_id") @db.Uuid
  courseName           String?            @map("course_name")
  studentName          String             @map("student_name")
  studentEmail         String?            @map("student_email")
  studentPhone         String?            @map("student_phone")
  studentTaxCode       String?            @map("student_tax_code")
  studentBirthDate     DateTime?          @map("student_birth_date") @db.Date
  purchaserName        String?            @map("purchaser_name")
  purchaserEmail       String?            @map("purchaser_email")
  purchaserPhone       String?            @map("purchaser_phone")
  purchaserTaxCode     String?            @map("purchaser_tax_code")
  sdiCode              String?            @map("sdi_code")
  pecEmail             String?            @map("pec_email")
  bookingStatus        Int                @default(1) @map("booking_status") @db.SmallInt
  paymentStatus        Int                @default(1) @map("payment_status") @db.SmallInt
  schedulingStatus     Int                @default(1) @map("scheduling_status") @db.SmallInt
  billingScheme        Int                @default(1) @map("billing_scheme") @db.SmallInt
  paymentMethod        Int                @default(1) @map("payment_method") @db.SmallInt
  amountPaid           Decimal            @default(0.00) @map("amount_paid") @db.Decimal(10, 2)
  registrationFee      Decimal            @default(0.00) @map("registration_fee") @db.Decimal(10, 2)
  discountAmount       Decimal            @default(0.00) @map("discount_amount") @db.Decimal(10, 2)
  promoCode            String?            @map("promo_code")
  startDate            DateTime?          @map("start_date") @db.Date
  scheduleDays         Int[]              @map("schedule_days")
  startTime            String?            @map("start_time")
  endTime              String?            @map("end_time")
  totalLessonsCount    Int?               @map("total_lessons_count")
  notes                String?
  stripeCustomerId     String?            @map("stripe_customer_id")
  stripeSubscriptionId String?            @map("stripe_subscription_id")
  subscriptionStatus   Int?               @map("subscription_status") @db.SmallInt
  subscriptionStartsAt DateTime?          @map("subscription_starts_at") @db.Timestamptz(6)
  subscriptionEndsAt   DateTime?          @map("subscription_ends_at") @db.Timestamptz(6)
  cancelAtPeriodEnd    Boolean            @default(false) @map("cancel_at_period_end")
  student_birth_place  String?
  customFields         Json?              @default("{}") @map("custom_fields")
  courseId             BigInt?            @map("course_id")
  groupId              BigInt?            @map("group_id")
  promoCodeId          BigInt?            @map("promo_code_id")
  formId               BigInt?            @map("form_id")
  attendanceRecords    AttendanceRecord[]
  course               Course?            @relation(fields: [courseId], references: [id], onUpdate: NoAction)
  formTemplate         FormTemplate?      @relation(fields: [formId], references: [id], onUpdate: NoAction)
  group                Group?             @relation(fields: [groupId], references: [id], onUpdate: NoAction)
  promoCodeRel         PromoCode?         @relation(fields: [promoCodeId], references: [id], onUpdate: NoAction)
  student              students?          @relation(fields: [studentId], references: [id], onUpdate: NoAction)
  user                 User?              @relation(fields: [userId], references: [id], onUpdate: NoAction)
  groupMembers         GroupMember[]
  lessons              Lesson[]
  payments             Payment[]

  @@index([userId], map: "idx_bookings_user_id")
  @@index([studentId], map: "idx_bookings_student_id")
  @@index([createdAt(sort: Desc)], map: "idx_bookings_created_at")
  @@index([paymentStatus], map: "idx_bookings_payment_status")
  @@index([bookingStatus], map: "idx_bookings_booking_status")
  @@index([purchaserTaxCode], map: "idx_bookings_purchaser_tax_code")
  @@index([studentTaxCode], map: "idx_bookings_student_tax_code")
  @@index([customFields], map: "idx_bookings_custom_fields", type: Gin)
  @@map("bookings")
}

model Lesson {
  createdAt         DateTime?          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime?          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  bookingId         String?            @map("booking_id") @db.Uuid
  studentId         String?            @map("student_id") @db.Uuid
  startsAt          DateTime           @map("starts_at") @db.Timestamptz(6)
  endsAt            DateTime           @map("ends_at") @db.Timestamptz(6)
  status            Int                @default(1)
  attendance        Int                @default(1)
  locationType      Int                @default(1) @map("location_type")
  meetingLink       String?            @map("meeting_link")
  homework          String?
  teacherNotes      String?            @map("teacher_notes")
  rescheduleCount   Int                @default(0) @map("reschedule_count")
  rescheduledAt     DateTime?          @map("rescheduled_at") @db.Timestamptz(6)
  teacherId         BigInt?            @map("teacher_id")
  courseId          BigInt?            @map("course_id")
  groupId           BigInt?            @map("group_id")
  id                BigInt             @id @default(autoincrement())
  attendanceRecords AttendanceRecord[]
  booking           Booking?           @relation(fields: [bookingId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  course            Course?            @relation(fields: [courseId], references: [id], onUpdate: NoAction)
  group             Group?             @relation(fields: [groupId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  student           students?          @relation(fields: [studentId], references: [id], onUpdate: NoAction)
  teacher           Teacher?           @relation(fields: [teacherId], references: [id], onUpdate: NoAction)

  @@index([bookingId], map: "idx_lessons_booking_id")
  @@index([studentId], map: "idx_lessons_student_id")
  @@index([startsAt], map: "idx_lessons_starts_at")
  @@index([status], map: "idx_lessons_status")
  @@map("lessons")
}

model Payment {
  id                    String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt             DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  paidAt                DateTime?          @default(now()) @map("paid_at") @db.Timestamptz(6)
  updatedAt             DateTime?          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  bookingId             String?            @map("booking_id") @db.Uuid
  studentId             String?            @map("student_id") @db.Uuid
  userId                String?            @map("user_id") @db.Uuid
  amount                Decimal            @db.Decimal(10, 2)
  currency              Int                @default(1) @db.SmallInt
  type                  Int                @default(1) @db.SmallInt
  status                Int                @default(2) @db.SmallInt
  paymentMethod         Int                @default(1) @map("payment_method") @db.SmallInt
  provider              Int                @default(1) @db.SmallInt
  providerTransactionId String?            @map("provider_transaction_id")
  notes                 String?
  annualMemberships     AnnualMembership[]
  booking               Booking?           @relation(fields: [bookingId], references: [id], onUpdate: NoAction)
  student               students?          @relation(fields: [studentId], references: [id], onUpdate: NoAction)
  user                  User?              @relation(fields: [userId], references: [id], onUpdate: NoAction)

  @@index([bookingId], map: "idx_payments_booking_id")
  @@index([studentId], map: "idx_payments_student_id")
  @@index([userId], map: "idx_payments_user_id")
  @@index([createdAt(sort: Desc)], map: "idx_payments_created_at")
  @@index([status], map: "idx_payments_status")
  @@index([type], map: "idx_payments_type")
  @@map("payments")
}

model AnnualMembership {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  taxCode          String    @map("tax_code")
  studentId        String?   @map("student_id") @db.Uuid
  userId           String?   @map("user_id") @db.Uuid
  membershipNumber String?   @map("membership_number")
  amount           Decimal   @default(30.00) @db.Decimal(10, 2)
  paymentMethod    Int       @default(1) @map("payment_method") @db.SmallInt
  paymentId        String?   @map("payment_id") @db.Uuid
  status           Int       @default(1) @db.SmallInt
  academicYear     String    @default("2026/2027") @map("academic_year")
  paidAt           DateTime  @default(now()) @map("paid_at") @db.Timestamptz(6)
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(6)
  payment          Payment?  @relation(fields: [paymentId], references: [id], onUpdate: NoAction)
  student          students? @relation(fields: [studentId], references: [id], onUpdate: NoAction)
  users            User?     @relation(fields: [userId], references: [id], onUpdate: NoAction)

  @@unique([taxCode, academicYear], map: "uq_tax_academic_year")
  @@index([studentId], map: "idx_annual_memberships_student_id")
  @@index([userId], map: "idx_annual_memberships_user_id")
  @@index([academicYear], map: "idx_annual_memberships_academic_year")
  @@map("annual_memberships")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model ContactMessage {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  firstName      String        @map("first_name")
  lastName       String        @map("last_name")
  email          String
  phone          String?
  interest       String?
  message        String
  status         Int           @default(1) @db.SmallInt
  notes          String?
  custom_fields  Json?         @default("{}")
  form_id        BigInt?
  form_templates FormTemplate? @relation(fields: [form_id], references: [id], onUpdate: NoAction)

  @@index([createdAt(sort: Desc)], map: "idx_contact_messages_created_at")
  @@index([status], map: "idx_contact_messages_status")
  @@index([custom_fields], map: "idx_contact_messages_custom_fields", type: Gin)
  @@map("contact_messages")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model documents {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  document_number String   @unique
  file_url        String?
  student_name    String
  student_email   String
  parent_name     String?
  joining_date    DateTime @default(dbgenerated("CURRENT_DATE")) @db.Date
  template_data   Json     @default("{}")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model stripe_webhook_events {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  stripe_event_id String   @unique
  event_type      String
  processed_at    DateTime @default(now()) @db.Timestamptz(6)
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model students {
  id                 String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  created_at         DateTime           @default(now()) @db.Timestamptz(6)
  updated_at         DateTime           @default(now()) @updatedAt @db.Timestamptz(6)
  first_name         String
  last_name          String
  full_name          String?
  email              String?
  phone              String?
  tax_code           String?
  birth_date         DateTime?          @db.Date
  photo_url          String?
  language_level     Int                @default(1) @db.SmallInt
  status             Int                @default(1) @db.SmallInt
  annual_fee_paid    Boolean            @default(false)
  annual_fee_paid_at DateTime?          @db.Timestamptz(6)
  registration_date  DateTime           @default(dbgenerated("CURRENT_DATE")) @db.Date
  parent_id          String?            @db.Uuid
  student_user_id    String?            @db.Uuid
  contract_id        String?            @db.Uuid
  birth_place        String?
  annualMemberships  AnnualMembership[]
  attendanceRecords  AttendanceRecord[]
  bookings           Booking[]
  groupMembers       GroupMember[]
  lessons            Lesson[]
  payments           Payment[]
  users              User?              @relation(fields: [student_user_id], references: [id], onUpdate: NoAction)

  @@index([parent_id], map: "idx_students_parent_id")
  @@index([student_user_id], map: "idx_students_student_user_id")
  @@index([tax_code], map: "idx_students_tax_code")
  @@index([status], map: "idx_students_status")
  @@index([email], map: "idx_students_email")
  @@index([created_at(sort: Desc)], map: "idx_students_created_at")
  @@map("students")
}

model Group {
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  name         String
  room         String?
  maxStudents  Int           @default(8) @map("max_students")
  status       Int           @default(1) @db.SmallInt
  startDate    DateTime?     @map("start_date") @db.Date
  endDate      DateTime?     @map("end_date") @db.Date
  scheduleDays Int[]         @map("schedule_days")
  startTime    String?       @map("start_time")
  endTime      String?       @map("end_time")
  notes        String?
  teacherId    BigInt?       @map("teacher_id")
  courseId     BigInt?       @map("course_id")
  id           BigInt        @id @default(autoincrement())
  bookings     Booking[]
  members      GroupMember[]
  course       Course?       @relation(fields: [courseId], references: [id], onUpdate: NoAction)
  teacher      Teacher?      @relation(fields: [teacherId], references: [id], onUpdate: NoAction)
  lessons      Lesson[]

  @@index([status], map: "idx_groups_status")
  @@map("groups")
}

model GroupMember {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  studentId String   @map("student_id") @db.Uuid
  bookingId String?  @map("booking_id") @db.Uuid
  joinedAt  DateTime @default(now()) @map("joined_at") @db.Timestamptz(6)
  status    Int      @default(1) @db.SmallInt
  groupId   BigInt?  @map("group_id")
  booking   Booking? @relation(fields: [bookingId], references: [id], onUpdate: NoAction)
  group     Group?   @relation(fields: [groupId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  student   students @relation(fields: [studentId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([studentId], map: "idx_group_members_student_id")
  @@map("group_members")
}

model AttendanceRecord {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  markedAt  DateTime  @default(now()) @map("marked_at") @db.Timestamptz(6)
  bookingId String?   @map("booking_id") @db.Uuid
  studentId String?   @map("student_id") @db.Uuid
  status    Int       @default(1) @db.SmallInt
  markedBy  String?   @map("marked_by")
  notes     String?
  lessonId  BigInt?   @map("lesson_id")
  booking   Booking?  @relation(fields: [bookingId], references: [id], onUpdate: NoAction)
  lesson    Lesson?   @relation(fields: [lessonId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  student   students? @relation(fields: [studentId], references: [id], onUpdate: NoAction)

  @@index([studentId], map: "idx_attendance_records_student_id")
  @@map("attendance_records")
}

model AppSetting {
  key         String   @id
  value       Json     @default("{}")
  description String?
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("app_settings")
}

model SchoolProfile {
  isDefault              Boolean  @default(true) @map("is_default")
  name                   String   @default("Atena School") @db.VarChar(255)
  legalName              String?  @map("legal_name") @db.VarChar(255)
  tagline                String?  @db.VarChar(255)
  founders               String?  @db.VarChar(255)
  logoUrl                String?  @map("logo_url")
  website                String?  @db.VarChar(255)
  siteUrl                String?  @map("site_url") @db.VarChar(255)
  appUrl                 String?  @map("app_url") @db.VarChar(255)
  adminUrl               String?  @map("admin_url") @db.VarChar(255)
  address                String?  @db.VarChar(255)
  city                   String?  @db.VarChar(100)
  cap                    String?  @db.VarChar(20)
  province               String?  @db.VarChar(10)
  country                String?  @default("Italia") @db.VarChar(100)
  mapsUrl                String?  @map("maps_url")
  phone                  String?  @db.VarChar(50)
  landline               String?  @db.VarChar(50)
  whatsapp               String?  @db.VarChar(50)
  email                  String?  @db.VarChar(255)
  secretariatEmail       String?  @map("secretariat_email") @db.VarChar(255)
  supportEmail           String?  @map("support_email") @db.VarChar(255)
  secretariatHours       String?  @map("secretariat_hours")
  vatCode                String?  @map("vat_code") @db.VarChar(100)
  registrationFeeEnabled Boolean  @default(true) @map("registration_fee_enabled")
  registrationFeeEur     Decimal  @default(30.00) @map("registration_fee_eur") @db.Decimal(10, 2)
  academicYear           String   @default("2026/2027") @map("academic_year") @db.VarChar(50)
  iban                   String?  @db.VarChar(100)
  bankName               String?  @map("bank_name") @db.VarChar(100)
  accountHolder          String?  @map("account_holder") @db.VarChar(255)
  socials                Json     @default("{}")
  createdAt              DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  id                     BigInt   @id @default(autoincrement())

  @@map("school_profiles")
}

model landing_api_logs {
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  controller       String   @db.VarChar(100)
  action           String   @db.VarChar(100)
  httpMethod       String   @map("http_method") @db.VarChar(10)
  endpoint         String   @db.VarChar(255)
  userId           String?  @map("user_id") @db.Uuid
  userRole         Int?     @map("user_role") @db.SmallInt
  ipAddress        String?  @map("ip_address") @db.VarChar(45)
  userAgent        String?  @map("user_agent")
  request          Json?
  response         Json?
  statusCode       Int      @map("status_code")
  session_id       String?
  guest_identifier String?
  id               BigInt   @id @default(autoincrement())

  @@index([createdAt(sort: Desc)], map: "idx_landing_api_logs_created_at")
  @@map("landing_api_logs")
}

model app_api_logs {
