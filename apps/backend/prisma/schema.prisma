datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String   @id @db.Uuid
  email     String   @unique
  firstName String   @map("first_name")
  lastName  String   @map("last_name")
  role      String   @default("student")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  bookings Booking[]

  @@map("users")
}

model Course {
  id                      String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                    String
  category                String?
  price                   Decimal?  @db.Decimal(10, 2)
  status                  String?   @default("active")
  photoUrl                String?   @map("photo_url") @db.Text
  description             String?   @default("")
  teacherId               String?   @map("teacher_id") @db.Uuid
  lessonsPerWeek          Int?      @map("lessons_per_week")
  sortOrder               Int?      @map("sort_order")
  scheduleType            String?   @map("schedule_type")
  totalLessons            Int?      @map("total_lessons")
  scheduleDays            Int[]     @map("schedule_days")
  startTime               String?   @map("start_time")
  endTime                 String?   @map("end_time")
  lessonDurationMinutes   Int?      @map("lesson_duration_minutes")
  totalHours              Int?      @map("total_hours")
  courseFormat            String?   @map("course_format")
  slug                    String?
  updatedAt               DateTime? @map("updated_at") @db.Timestamptz

  bookings       Booking[]
  courseTeachers CourseTeacher[]

  @@map("courses")
}

model Teacher {
  teacherId      String    @id @map("teacher_id") @db.Uuid
  fullName       String?   @map("full_name")
  photoUrl       String?   @map("photo_url")
  status         String?
  experience     String?
  hireDate       DateTime? @map("hire_date") @db.Date
  birthDate      DateTime? @map("birth_date") @db.Date
  colorValue     BigInt?   @map("color_value")
  contractId     String?   @map("contract_id") @db.Uuid
  updatedAt      DateTime? @map("updated_at") @db.Timestamptz

  courseTeachers CourseTeacher[]
  lessons        Lesson[]

  @@map("teachers")
}

model CourseTeacher {
  courseId  String @map("course_id") @db.Uuid
  teacherId String @map("teacher_id") @db.Uuid

  course  Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  teacher Teacher @relation(fields: [teacherId], references: [teacherId], onDelete: Cascade)

  @@id([courseId, teacherId])
  @@map("course_teachers")
}

model Booking {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  courseId              String?   @map("course_id") @db.Uuid
  userId                String?   @map("user_id") @db.Uuid
  courseName            String    @map("course_name")
  purchaserName         String?   @map("purchaser_name")
  purchaserEmail        String?   @map("purchaser_email")
  purchaserPhone        String?   @map("purchaser_phone")
  purchaserTaxCode      String?   @map("purchaser_tax_code")
  studentName           String    @map("student_name")
  studentEmail          String?   @map("student_email")
  studentPhone          String?   @map("student_phone")
  studentTaxCode        String?   @map("student_tax_code")
  studentBirthDate      DateTime? @map("student_birth_date") @db.Date
  amountPaid            Decimal   @default(0) @map("amount_paid") @db.Decimal(10, 2)
  registrationFee       Decimal   @default(0) @map("registration_fee") @db.Decimal(10, 2)
  paymentStatus         String    @default("reserved") @map("payment_status")
  paymentMethod         String    @default("cash") @map("payment_method")
  schedulingStatus      String    @default("pending_coordination") @map("scheduling_status")
  scheduleDays          Int[]     @default([]) @map("schedule_days")
  startTime             String?   @map("start_time")
  endTime               String?   @map("end_time")
  startDate             DateTime? @map("start_date") @db.Timestamptz
  sdiCode               String?   @map("sdi_code")
  pecEmail              String?   @map("pec_email")
  notes                 String?   @db.Text
  billingScheme         String    @default("full") @map("billing_scheme")
  totalLessonsCount     Int?      @map("total_lessons_count")
  subscriptionStartsAt  DateTime? @map("subscription_starts_at") @db.Timestamptz
  subscriptionEndsAt    DateTime? @map("subscription_ends_at") @db.Timestamptz
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz

  course Course?  @relation(fields: [courseId], references: [id], onDelete: SetNull)
  user   User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  lessons Lesson[]
  payments Payment[]

  @@index([userId])
  @@index([courseId])
  @@index([paymentStatus])
  @@index([schedulingStatus])
  @@index([createdAt])
  @@map("bookings")
}

model Lesson {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bookingId       String?   @map("booking_id") @db.Uuid
  teacherId       String?   @map("teacher_id") @db.Uuid
  startsAt        DateTime  @map("starts_at") @db.Timestamptz
  endsAt          DateTime  @map("ends_at") @db.Timestamptz
  status          String    @default("scheduled")
  paymentStatus   String    @default("pending") @map("payment_status")
  pricePerLesson  Decimal?   @map("price_per_lesson") @db.Decimal(10, 2)
  attendance      String?
  homework        String?
  teacherNotes    String?   @map("teacher_notes")
  rescheduleCount Int?      @default(0) @map("reschedule_count")
  rescheduledAt   DateTime? @map("rescheduled_at") @db.Timestamptz
  locationType    String?   @default("offline") @map("location_type")
  meetingLink     String?   @map("meeting_link")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime? @updatedAt @map("updated_at") @db.Timestamptz

  booking Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  teacher Teacher? @relation(fields: [teacherId], references: [teacherId], onDelete: SetNull)

  @@index([bookingId])
  @@index([teacherId])
  @@index([startsAt])
  @@map("lessons")
}

model Payment {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bookingId             String?   @map("booking_id") @db.Uuid
  userId                String?   @map("user_id") @db.Uuid
  scheduleId            String?   @map("schedule_id") @db.Uuid
  amount                Decimal   @db.Decimal(10, 2)
  currency              String    @default("EUR")
  paymentMethod         String    @map("payment_method")
  type                  String    @default("payment")
  status                String    @default("succeeded")
  provider              String    @default("manual")
  providerTransactionId String?   @map("provider_transaction_id")
  notes                 String?   @db.Text
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz
  paidAt                DateTime? @map("paid_at") @db.Timestamptz
  updatedAt             DateTime? @updatedAt @map("updated_at") @db.Timestamptz

  booking Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  @@index([bookingId])
  @@index([userId])
  @@index([status])
  @@map("payments")
}

model AnnualMembership {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  taxCode      String?   @map("tax_code")
  email        String?
  phone        String?
  academicYear String    @default("2026/2027") @map("academic_year")
  status       String    @default("active")
  studentId    String?   @map("student_id") @db.Uuid
  userId       String?   @map("user_id") @db.Uuid
  bookingId    String?   @unique @map("booking_id") @db.Uuid
  paidAt       DateTime  @default(now()) @map("paid_at") @db.Timestamptz
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz

  @@index([status])
  @@index([academicYear])
  @@index([studentId])
  @@map("annual_memberships")
}
