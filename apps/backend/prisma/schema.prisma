generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id         String    @id @db.Uuid
  email      String    @unique
  firstName  String    @map("first_name")
  lastName   String    @map("last_name")
  role       String
  isActive   Boolean   @default(true) @map("is_active")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  phone      String?   @db.VarChar
  avatar_url String?
  updated_at DateTime? @default(now()) @db.Timestamptz(6)
  full_name  String?
  tax_code   String?
  notes      String?
  sdi_code   String?
  pec_email  String?

  bookings   Booking[]
  payments   Payment[]

  @@map("users")
}

model Course {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  name                  String
  slug                  String    @unique
  category              Int       @default(1) @db.SmallInt
  status                Int       @default(1) @db.SmallInt
  sortOrder             Int?      @default(0) @map("sort_order")
  photoUrl              String?   @map("photo_url")
  description           String?
  teacherId             String?   @map("teacher_id") @db.Uuid
  courseFormat          Int       @default(1) @map("course_format") @db.SmallInt
  scheduleType          Int       @default(1) @map("schedule_type") @db.SmallInt
  scheduleDays          Int[]     @map("schedule_days")
  startTime             String?   @map("start_time")
  endTime               String?   @map("end_time")
  lessonDurationMinutes Int?      @map("lesson_duration_minutes")
  lessonsPerWeek        Int?      @map("lessons_per_week")
  totalLessons          Int?      @map("total_lessons")
  totalHours            Int?      @map("total_hours")
  billingType           Int       @default(1) @map("billing_type") @db.SmallInt
  price                 Decimal?  @db.Decimal(10, 2)
  subscriptionPrice     Decimal?  @map("subscription_price") @db.Decimal(10, 2)
  stripeMonthlyPriceId  String?   @map("stripe_monthly_price_id")

  bookings              Booking[]
  courseTeachers        CourseTeacher[]
  lessons               Lesson[]

  @@index([slug], map: "idx_courses_slug")
  @@index([status], map: "idx_courses_status")
  @@index([teacherId], map: "idx_courses_teacher_id")
  @@index([category], map: "idx_courses_category")
  @@map("courses")
}

model Teacher {
  teacherId  String    @id @map("teacher_id") @db.Uuid
  experience String?
  status     String?   @default("active")
  hireDate   DateTime? @default(now()) @map("hire_date") @db.Date
  birthDate  DateTime? @map("birth_date") @db.Date
  photoUrl   String?   @map("photo_url")
  contractId String?   @map("contract_id") @db.Uuid
  colorValue BigInt?   @default(4279899379) @map("color_value")
  fullName   String?   @map("full_name")
  updatedAt  DateTime? @default(now()) @map("updated_at") @db.Timestamptz(6)

  lessons        Lesson[]
  courseTeachers CourseTeacher[]

  @@map("teachers")
}

model CourseTeacher {
  courseId  String   @map("course_id") @db.Uuid
  teacherId String   @map("teacher_id") @db.Uuid
  role      Int      @default(1) @db.SmallInt
  isPrimary Boolean  @default(true) @map("is_primary")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  course  Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  teacher Teacher @relation(fields: [teacherId], references: [teacherId], onDelete: Cascade)

  @@id([courseId, teacherId])
  @@index([teacherId], map: "idx_course_teachers_teacher_id")
  @@map("course_teachers")
}

model Booking {
  id                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  sessionId            String?   @map("session_id")
  userId               String?   @map("user_id") @db.Uuid
  studentId            String?   @map("student_id") @db.Uuid
  courseId             String?   @map("course_id") @db.Uuid
  courseName           String?   @map("course_name")

  studentName          String    @map("student_name")
  studentEmail         String?   @map("student_email")
  studentPhone         String?   @map("student_phone")
  studentTaxCode       String?   @map("student_tax_code")
  studentBirthDate     DateTime? @map("student_birth_date") @db.Date

  purchaserName        String?   @map("purchaser_name")
  purchaserEmail       String?   @map("purchaser_email")
  purchaserPhone       String?   @map("purchaser_phone")
  purchaserTaxCode     String?   @map("purchaser_tax_code")
  sdiCode              String?   @map("sdi_code")
  pecEmail             String?   @map("pec_email")

  bookingStatus        Int       @default(1) @map("booking_status") @db.SmallInt
  paymentStatus        Int       @default(1) @map("payment_status") @db.SmallInt
  schedulingStatus     Int       @default(1) @map("scheduling_status") @db.SmallInt

  billingScheme        Int       @default(1) @map("billing_scheme") @db.SmallInt
  paymentMethod        Int       @default(1) @map("payment_method") @db.SmallInt
  amountPaid           Decimal   @default(0.00) @map("amount_paid") @db.Decimal(10, 2)
  registrationFee      Decimal   @default(0.00) @map("registration_fee") @db.Decimal(10, 2)
  discountAmount       Decimal   @default(0.00) @map("discount_amount") @db.Decimal(10, 2)
  promoCode            String?   @map("promo_code")

  startDate            DateTime? @map("start_date") @db.Date
  scheduleDays         Int[]     @map("schedule_days")
  startTime            String?   @map("start_time")
  endTime              String?   @map("end_time")
  totalLessonsCount    Int?      @map("total_lessons_count")
  notes                String?

  stripeCustomerId     String?   @map("stripe_customer_id")
  stripeSubscriptionId String?   @map("stripe_subscription_id")
  subscriptionStatus   Int?      @map("subscription_status") @db.SmallInt
  subscriptionStartsAt DateTime? @map("subscription_starts_at") @db.Timestamptz(6)
  subscriptionEndsAt   DateTime? @map("subscription_ends_at") @db.Timestamptz(6)
  cancelAtPeriodEnd    Boolean   @default(false) @map("cancel_at_period_end")

  course               Course?            @relation(fields: [courseId], references: [id], onDelete: SetNull)
  student              students?          @relation(fields: [studentId], references: [id], onDelete: SetNull)
  user                 User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  lessons              Lesson[]
  payments             Payment[]
  attendanceRecords    AttendanceRecord[]

  @@index([userId], map: "idx_bookings_user_id")
  @@index([studentId], map: "idx_bookings_student_id")
  @@index([courseId], map: "idx_bookings_course_id")
  @@index([sessionId], map: "idx_bookings_session_id")
  @@index([createdAt], map: "idx_bookings_created_at")
  @@index([paymentStatus], map: "idx_bookings_payment_status")
  @@index([bookingStatus], map: "idx_bookings_booking_status")
  @@index([schedulingStatus], map: "idx_bookings_scheduling_status")
  @@index([purchaserTaxCode], map: "idx_bookings_purchaser_tax_code")
  @@index([studentTaxCode], map: "idx_bookings_student_tax_code")
  @@index([stripeSubscriptionId], map: "idx_bookings_stripe_subscription_id")
  @@index([studentId, courseId, paymentStatus, bookingStatus], map: "idx_bookings_active_services")
  @@map("bookings")
}

model Lesson {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt       DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)
  bookingId       String    @map("booking_id") @db.Uuid
  courseId        String?   @map("course_id") @db.Uuid
  studentId       String?   @map("student_id") @db.Uuid
  teacherId       String?   @map("teacher_id") @db.Uuid
  startsAt        DateTime  @map("starts_at") @db.Timestamptz(6)
  endsAt          DateTime  @map("ends_at") @db.Timestamptz(6)
  status          Int       @default(1)
  attendance      Int       @default(1)
  locationType    Int       @default(1) @map("location_type")
  meetingLink     String?   @map("meeting_link")
  homework        String?
  teacherNotes    String?   @map("teacher_notes")
  rescheduleCount Int       @default(0) @map("reschedule_count")
  rescheduledAt   DateTime? @map("rescheduled_at") @db.Timestamptz(6)
  updatedAt       DateTime? @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  booking           Booking            @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  course            Course?            @relation(fields: [courseId], references: [id], onDelete: SetNull)
  student           students?          @relation(fields: [studentId], references: [id], onDelete: SetNull)
  teacher           Teacher?           @relation(fields: [teacherId], references: [teacherId], onDelete: SetNull)
  attendanceRecords AttendanceRecord[]

  @@index([bookingId], map: "idx_lessons_booking_id")
  @@index([courseId], map: "idx_lessons_course_id")
  @@index([studentId], map: "idx_lessons_student_id")
  @@index([teacherId], map: "idx_lessons_teacher_id")
  @@index([startsAt], map: "idx_lessons_starts_at")
  @@index([status], map: "idx_lessons_status")
  @@map("lessons")
}

model Payment {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  paidAt                DateTime? @default(now()) @map("paid_at") @db.Timestamptz(6)
  updatedAt             DateTime? @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  bookingId             String?   @map("booking_id") @db.Uuid
  studentId             String?   @map("student_id") @db.Uuid
  userId                String?   @map("user_id") @db.Uuid

  amount                Decimal   @db.Decimal(10, 2)
  currency              Int       @default(1) @db.SmallInt
  type                  Int       @default(1) @db.SmallInt
  status                Int       @default(2) @db.SmallInt
  paymentMethod         Int       @default(1) @map("payment_method") @db.SmallInt
  provider              Int       @default(1) @db.SmallInt
  providerTransactionId String?   @map("provider_transaction_id")
  notes                 String?

  booking               Booking?           @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  student               students?          @relation(fields: [studentId], references: [id], onDelete: SetNull)
  user                  User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  annualMemberships     AnnualMembership[]

  @@index([bookingId], map: "idx_payments_booking_id")
  @@index([studentId], map: "idx_payments_student_id")
  @@index([userId], map: "idx_payments_user_id")
  @@index([createdAt], map: "idx_payments_created_at")
  @@index([paidAt], map: "idx_payments_paid_at")
  @@index([status], map: "idx_payments_status")
  @@index([type], map: "idx_payments_type")
  @@map("payments")
}

model AnnualMembership {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  taxCode          String    @map("tax_code")
  studentId        String?   @map("student_id") @db.Uuid
  userId           String?   @map("user_id") @db.Uuid
  membershipNumber String?   @map("membership_number")
  amount           Decimal   @default(30.00) @db.Decimal(10, 2)
  paymentMethod    Int       @default(1) @map("payment_method") @db.SmallInt
  paymentId        String?   @map("payment_id") @db.Uuid
  status           Int       @default(1) @db.SmallInt
  academicYear     String    @default("2026/2027") @map("academic_year")
  paidAt           DateTime  @default(now()) @map("paid_at") @db.Timestamptz(6)
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(6)

  student   students? @relation(fields: [studentId], references: [id], onDelete: SetNull)
  payment   Payment?  @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@unique([taxCode, academicYear])
  @@index([studentId], map: "idx_annual_memberships_student_id")
  @@index([userId], map: "idx_annual_memberships_user_id")
  @@index([paymentId], map: "idx_annual_memberships_payment_id")
  @@index([academicYear], map: "idx_annual_memberships_academic_year")
  @@index([status], map: "idx_annual_memberships_status")
  @@map("annual_memberships")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model contact_messages {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  created_at DateTime? @default(now()) @db.Timestamptz(6)
  first_name String
  last_name  String
  email      String
  phone      String?
  interest   String?
  message    String
  status     String    @default("new")
  notes      String?
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model documents {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  document_number String   @unique
  file_url        String?
  student_name    String
  student_email   String
  parent_name     String?
  joining_date    DateTime @default(now()) @db.Date
  template_data   Json
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model stripe_webhook_events {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  stripe_event_id String    @unique
  event_type      String
  processed_at    DateTime? @default(now()) @db.Timestamptz(6)
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model students {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  language_level     Int       @default(1) @db.SmallInt
  status             Int       @default(1) @db.SmallInt
  registration_date  DateTime  @default(now()) @db.Date
  contract_id        String?   @db.Uuid
  birth_date         DateTime? @db.Date
  photo_url          String?
  parent_id          String?   @db.Uuid
  first_name         String?
  last_name          String?
  full_name          String?
  annual_fee_paid    Boolean?  @default(false)
  annual_fee_paid_at DateTime? @db.Timestamptz(6)
  email              String?
  student_user_id    String?   @db.Uuid
  tax_code           String?
  phone              String?
  updated_at         DateTime? @default(now()) @db.Timestamptz(6)

  payments          Payment[]
  annualMemberships AnnualMembership[]
  lessons           Lesson[]
  bookings          Booking[]
}

model AttendanceRecord {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  lessonId  String   @map("lesson_id") @db.Uuid
  bookingId String?  @map("booking_id") @db.Uuid
  studentId String?  @map("student_id") @db.Uuid
  status    String   @default("present")
  markedBy  String?  @map("marked_by")
  markedAt  DateTime @default(now()) @map("marked_at") @db.Timestamptz
  notes     String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  lesson  Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  booking Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  @@index([lessonId])
  @@index([bookingId])
  @@index([status])
  @@map("attendance_records")
}

model AppSetting {
  key         String   @id
  value       Json     @default("{}")
  description String?
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("app_settings")
}


