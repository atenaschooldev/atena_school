datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String   @id @db.Uuid
  email     String   @unique
  firstName String   @map("first_name")
  lastName  String   @map("last_name")
  role      String   @default("student")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  bookings Booking[]

  @@map("users")
}

model Course {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String
  category     String
  duration     String
  price        Decimal  @db.Decimal(10, 2)
  status       String   @default("active")
  teacherId    String?  @map("teacher_id") @db.Uuid
  studentCount Int      @default(0) @map("student_count")
  description  String?  @default("")
  imageUrl     String?  @map("image_url") @db.Text
  level        String?  @default("A1")
  capacity     Int      @default(10)

  schedules Schedule[]
  bookings  Booking[]

  @@map("courses")
}

model Schedule {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  courseId   String   @map("course_id") @db.Uuid
  teacherId  String   @map("teacher_id") @db.Uuid
  room       String?
  status     String   @default("scheduled")
  startDate  DateTime @map("start_date") @db.Timestamptz
  endDate    DateTime @map("end_date") @db.Timestamptz
  lessonType String   @default("offline") @map("lesson_type")
  meetingUrl String?  @map("meeting_url")

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@map("schedules")
}

model Booking {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  courseId              String?   @map("course_id") @db.Uuid
  userId                String?   @map("user_id") @db.Uuid
  courseName            String    @map("course_name")
  purchaserName         String    @map("purchaser_name")
  purchaserEmail        String    @map("purchaser_email")
  purchaserPhone        String?   @map("purchaser_phone")
  purchaserTaxCode      String?   @map("purchaser_tax_code")
  studentName           String    @map("student_name")
  studentEmail          String?   @map("student_email")
  studentPhone          String?   @map("student_phone")
  studentTaxCode        String?   @map("student_tax_code")
  studentBirthDate      DateTime? @map("student_birth_date") @db.Date
  isForChild            Boolean   @default(false) @map("is_for_child")
  amountPaid            Decimal   @default(0) @map("amount_paid") @db.Decimal(10, 2)
  registrationFee       Decimal   @default(0) @map("registration_fee") @db.Decimal(10, 2)
  paymentStatus         String    @default("reserved") @map("payment_status")
  paymentMethod         String    @default("cash") @map("payment_method")
  schedulingStatus      String    @default("pending_coordination") @map("scheduling_status")
  scheduleDays          Int[]     @default([]) @map("schedule_days")
  startTime             String?   @map("start_time")
  endTime               String?   @map("end_time")
  startDate             DateTime? @map("start_date") @db.Timestamptz
  sdiCode               String?   @map("sdi_code")
  pecEmail              String?   @map("pec_email")
  notes                 String?   @db.Text
  totalLessonsCount     Int?      @map("total_lessons_count")
  subscriptionStartsAt  DateTime? @map("subscription_starts_at") @db.Timestamptz
  subscriptionEndsAt    DateTime? @map("subscription_ends_at") @db.Timestamptz
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz

  course Course? @relation(fields: [courseId], references: [id], onDelete: SetNull)
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([courseId])
  @@index([paymentStatus])
  @@index([schedulingStatus])
  @@index([createdAt])
  @@map("bookings")
}
