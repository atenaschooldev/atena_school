datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String   @id @db.Uuid
  email     String   @unique
  firstName String   @map("first_name")
  lastName  String   @map("last_name")
  role      String
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  student      Student?
  teacher      Teacher?
  activityLogs ActivityLog[]

  @@map("users")
}

model Student {
  studentId        String    @id @map("student_id") @db.Uuid
  languageLevel    String    @default("A1") @map("language_level")
  status           String    @default("active")
  registrationDate DateTime  @default(now()) @map("registration_date") @db.Date
  contractId       String?   @map("contract_id") @db.Uuid

  user        User         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  contract    Document?    @relation(name: "StudentContract", fields: [contractId], references: [id], onDelete: SetNull)
  payments    Payment[]
  grades      Grade[]
  attendances Attendance[]

  @@map("students")
}

model Teacher {
  teacherId  String   @id @map("teacher_id") @db.Uuid
  subject    String?
  experience String?
  status     String   @default("active")
  hireDate   DateTime @default(now()) @map("hire_date") @db.Date

  user        User         @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  courses     Course[]
  schedules   Schedule[]
  grades      Grade[]
  attendances Attendance[]

  @@map("teachers")
}

model Course {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String
  category     String
  duration     String
  price        Decimal  @db.Decimal(10, 2)
  status       String   @default("active")
  teacherId    String?  @map("teacher_id") @db.Uuid
  studentCount Int      @default(0) @map("student_count")

  teacher   Teacher?   @relation(fields: [teacherId], references: [teacherId], onDelete: SetNull)
  schedules Schedule[]
  grades    Grade[]

  @@map("courses")
}

model Schedule {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  courseId   String   @map("course_id") @db.Uuid
  teacherId  String   @map("teacher_id") @db.Uuid
  room       String?
  status     String   @default("scheduled")
  startDate  DateTime @map("start_date") @db.Timestamptz
  endDate    DateTime @map("end_date") @db.Timestamptz
  lessonType String   @default("offline") @map("lesson_type")
  meetingUrl String?  @map("meeting_url")

  course      Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  teacher     Teacher      @relation(fields: [teacherId], references: [teacherId], onDelete: Restrict)
  attendances Attendance[]

  @@map("schedules")
}

model Document {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  documentNumber String   @unique @map("document_number")
  fileUrl        String?  @map("file_url")
  studentName    String   @map("student_name")
  studentEmail   String   @map("student_email")
  parentName     String?  @map("parent_name")
  joiningDate    DateTime @default(now()) @map("joining_date") @db.Date
  templateData   Json     @map("template_data")

  students Student[] @relation(name: "StudentContract")

  @@map("documents")
}

model Payment {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  paymentNumber String   @unique @map("payment_number")
  studentId     String   @map("student_id") @db.Uuid
  price         Decimal  @db.Decimal(10, 2)
  paymentType   String   @map("payment_type")
  status        String   @default("pending")
  paymentDate   DateTime @default(now()) @map("payment_date") @db.Timestamptz

  student Student @relation(fields: [studentId], references: [studentId], onDelete: Restrict)

  @@map("payments")
}

model Grade {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  studentId String   @map("student_id") @db.Uuid
  courseId  String   @map("course_id") @db.Uuid
  teacherId String   @map("teacher_id") @db.Uuid
  score     Decimal  @db.Decimal(4, 1)
  date      DateTime @default(now()) @db.Date
  note      String?

  student Student @relation(fields: [studentId], references: [studentId], onDelete: Cascade)
  course  Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  teacher Teacher @relation(fields: [teacherId], references: [teacherId], onDelete: Restrict)

  @@map("grades")
}

model Attendance {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  studentId  String   @map("student_id") @db.Uuid
  teacherId  String   @map("teacher_id") @db.Uuid
  scheduleId String   @map("schedule_id") @db.Uuid
  status     String
  note       String?
  date       DateTime @default(now()) @db.Date

  student  Student  @relation(fields: [studentId], references: [studentId], onDelete: Cascade)
  teacher  Teacher  @relation(fields: [teacherId], references: [teacherId], onDelete: Restrict)
  schedule Schedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  @@map("attendance")
}

model ActivityLog {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  operatorId   String?  @map("operator_id") @db.Uuid
  operatorName String   @map("operator_name")
  action       String
  module       String
  targetId     String?  @map("target_id") @db.Uuid
  details      Json
  status       String   @default("success")

  operator User? @relation(fields: [operatorId], references: [id], onDelete: SetNull)

  @@map("activity_logs")
}
