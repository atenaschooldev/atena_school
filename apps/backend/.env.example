# ==============================================================================
# ATENA SCHOOL — BACKEND REST API (.env.example)
# ==============================================================================
# Скопируйте этот файл в .env и укажите реальные параметры.
# ==============================================================================

# --- SERVER CONFIGURATION ---
# Порт запуска NestJS Fastify сервера
PORT=4000

# Разрешенные CORS-домены через запятую (фронтенды лендинга, ЛК и CRM)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:5173,https://atena-school-landing-three.vercel.app,https://atena-school-app.vercel.app,https://atena-school-admin.vercel.app

# --- DATABASE CONNECTION (PRISMA / POSTGRES) ---
# Основная строка подключения к базе данных Postgres Supabase (с поддержкой connection pooling pgbouncer)
DATABASE_URL=postgresql://postgres.your-project-ref:your-db-password@aws-1-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true

# Прямое подключение к Postgres (для выполнения миграций Prisma без прокси)
DIRECT_URL=postgresql://postgres.your-project-ref:your-db-password@aws-1-eu-central-1.pooler.supabase.com:5432/postgres

# --- SUPABASE ADMIN SDK ---
# URL проекта Supabase
SUPABASE_URL=https://your-project-ref.supabase.co

# Публичный анонимный ключ Supabase (Anon Key / Publishable Key)
SUPABASE_KEY=sb_publishable_your_supabase_anon_key

# Сервисный ключ Supabase Admin (Service Role Key — полные права для бэкенда)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key

# JWT Секрет Supabase для локальной верификации токенов
SUPABASE_JWT_SECRET=your_supabase_jwt_secret

# --- APPLICATION URLS ---
# URL главного сайта-лендинга
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# URL Личного Кабинета студента
NEXT_PUBLIC_APP_URL=http://localhost:3002

# URL панели администратора CRM
ADMIN_URL=https://atena-school-admin.vercel.app

# --- STRIPE PAYMENTS ---
# Секретный ключ Stripe API для проведения и верификации оплат
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key

# Секретный ключ подписи вебхуков Stripe
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_signing_secret

# --- EMAIL NOTIFICATIONS (RESEND / SMTP) ---
# API ключ сервиса Resend (рекомендуется)
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=Atena School <info@atenaschool.com>

# SMTP (альтернатива Resend, опционально)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# --- TELEGRAM NOTIFICATIONS (OPTIONAL) ---
# Токен бота Telegram для моментальных алертов о бронированиях
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- NESTJS OBSERVE APM & OBSERVABILITY (OPTIONAL) ---
# Ключи из панели observe.nestjs.com
OBSERVE_APP_KEY=
OBSERVE_APP_SECRET=
# Имя сервиса в дашборде (произвольное, по умолчанию: atena-school-api)
OBSERVE_SERVICE_ID=atena-school-api
