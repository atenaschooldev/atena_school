{
  "name": "desktop",
  "version": "1.0.0",
  "private": true,
  "main": "src/main.js",
  "scripts": {
    "dev": "electron .",
    "build": "pnpm --filter admin run build",
    "dist": "pnpm build && electron-builder"
  },
  "dependencies": {
    "dotenv": "^16.4.7"
  },
  "devDependencies": {
    "electron": "^34.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.atenaschool.admin",
    "productName": "Atena School CRM",
    "directories": {
      "output": "dist-app"
    },
    "files": [
      "src/**/*",
      "../admin/dist/**/*"
    ],
    "mac": {
      "category": "public.app-category.education",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "target": [
        "nsis",
        "zip"
      ]
    }
  }
}
