# ==============================================================================
# ATENA SCHOOL — LANDING APP (.env.example)
# ==============================================================================
# Скопируйте этот файл в .env.local (для локальной разработки) или импортируйте в Vercel.
# 
# ⚠️ ПРАВИЛО БЕЗОПАСНОСТИ NEXT.JS:
# • Ключи с префиксом NEXT_PUBLIC_* попадают в клиентский JS-бандл (видны всем в браузере).
# • Ключи БЕЗ префикса NEXT_PUBLIC_* доступны ТОЛЬКО на сервере (секреты и API-ключи).
# ==============================================================================

# ==============================================================================
# 🟢 1. PUBLIC CLIENT VARIABLES (Доступны в браузере)
# ==============================================================================

# URL проекта Supabase
NEXT_PUBLIC_SUPABASE_URL=https://hcxpfzsmzusolvhtuhhm.supabase.co

# Публичный анонимный ключ Supabase (Anon Key / Publishable Key)
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_Adw-8ADIiPhDjlkQR81pYA_PJJprFxl

# Публичный URL лендинга
# Локально: http://localhost:3000
# Продакшн Vercel: https://atena-school-landing-three.vercel.app (или кастомный домен https://atenaschool.com)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Публичный URL Личного Кабинета (для ссылок входа и кнопок в меню/чекауте)
# Локально: http://localhost:3002
# Продакшн Vercel: https://atena-school-app.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3002

# URL REST API бэкенда NestJS (опционально, если бэкенд развернут отдельно)
NEXT_PUBLIC_BACKEND_URL=http://localhost:4000

# Публичный ключ Stripe для элементов оплаты в браузере (Stripe Elements / Checkout)
# Тестовый: pk_test_... | Боевой: pk_live_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key

# Маркетинг и аналитика (опционально)
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_CLARITY_ID=


# ==============================================================================
# 🔒 2. PRIVATE SERVER-ONLY SECRETS (Строго приватные, НИКОГДА не попадут клиенту)
# ==============================================================================

# Сервисный ключ Supabase Admin (Service Role Key)
# ❗️ КРИТИЧЕСКИ ВАЖЕН для чекаута, записи броней и Stripe webhook без блокировок RLS.
# Получить в: Supabase Dashboard → Project Settings → API Keys → service_role secret
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key

# Секретный ключ Stripe API для создания платежных сессий на сервере
# Тестовый: sk_test_... | Боевой: sk_live_...
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key

# Секрет подписи вебхуков Stripe для верификации запросов от Stripe на /landing/webhooks/stripe
# Получить в: Stripe Dashboard → Developers → Webhooks → Signing secret (whsec_...)
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_signing_secret

# Секретный токен для защиты внутренних API вызовов (сервер-сервер)
# Сгенерируйте произвольную строку (например: openssl rand -hex 24)
INTERNAL_API_SECRET=atena_internal_secret_change_me_in_prod

# Email-уведомления (сервис Resend) — для отправки чеков и подтверждений бронирования
# Получить в: https://resend.com/api-keys
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=Atena School <info@atenaschool.com>
SCHOOL_ADMIN_EMAIL=info@atenaschool.com

# Telegram-уведомления администрации о новых бронях (опционально)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=

# Upstash Redis для защиты API от DDoS и спама (Rate-limiting) (опционально)
# Получить в: https://console.upstash.com
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
