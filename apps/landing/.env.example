# ==============================================================================
# ATENA SCHOOL - LANDING APP ENVIRONMENT VARIABLES EXAMPLE
# Скопируйте этот файл в .env и укажите реальные значения
# ==============================================================================

# --- SUPABASE CONFIGURATION ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here   # REQUIRED in production

# --- APPLICATION URLS ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3002
NEXT_PUBLIC_BACKEND_URL=http://localhost:4000

# --- UPSTASH REDIS (rate limiting) ---
# Получить на: https://console.upstash.com → Create Database → REST API
# REQUIRED in production (rate limiting is disabled if not set)
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token-here

# --- STRIPE ---
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# --- EMAIL (Resend) ---
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=Atena School <prenotazioni@atenaschool.com>
SCHOOL_ADMIN_EMAIL=info@atenaschool.com

# --- ANALYTICS & MONITORING (OPTIONAL) ---
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX
NEXT_PUBLIC_CLARITY_ID=XXXXXXXXXX
