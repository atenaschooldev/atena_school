{
  "name": "atena-monorepo",
  "private": true,
  "packageManager": "pnpm@11.13.1",
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "dev:desktop": "pnpm --filter desktop dev",
    "dev:all": "node scripts/dev-runner.js prod",
    "dev:dev": "node scripts/dev-runner.js dev",
    "dev:dev:all": "node scripts/dev-runner.js dev",
    "dev:prod": "node scripts/dev-runner.js prod",
    "dev:prod:all": "node scripts/dev-runner.js prod",
    "studio": "node scripts/run-studio.js prod",
    "studio:prod": "node scripts/run-studio.js prod",
    "studio:dev": "node scripts/run-studio.js dev",
    "analyze:landing": "pnpm --filter landing analyze",
    "analyze:app": "pnpm --filter app analyze",
    "doc:arch": "pnpm --filter backend compodoc",
    "doc:arch:build": "pnpm --filter backend compodoc:build",
    "start:crm": "node scripts/start-crm-prod.js prod",
    "start:prod": "node scripts/start-crm-prod.js prod"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "pg": "^8.23.0",
    "prettier": "^3.7.3",
    "turbo": "^2.4.0",
    "typescript": "^5.8.3",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "pnpm": {
    "only-built-dependencies": [
      "@nestjs/core",
      "@prisma/client",
      "@prisma/engines",
      "esbuild",
      "prisma",
      "sharp",
      "unrs-resolver"
    ]
  },
  "dependencies": {
    "@internationalized/date": "^3.12.2"
  }
}
